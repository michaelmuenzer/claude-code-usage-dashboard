# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored — these are local secrets, even though this stack is for
# local-dev-only use and never exposed beyond localhost.

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=               # openssl rand -base64 24
CLICKHOUSE_DB=otel
PORT=3001                          # dashboard app port

# Optional — only needed if you add the otlphttp/langfuse exporter described in the
# README's "Sending telemetry to both Langfuse and this dashboard at once" section.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
